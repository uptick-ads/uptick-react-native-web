# Copy to .env.local (gitignored). Two placements demonstrate both presentations: one whose template is inline, one whose template is a popup.
# These point at the platform's local seed data (Northbound Outfitters for popup, Pawsome Pet Supply for inline).
EXPO_PUBLIC_UPTICK_HOST=api.uptick.test
EXPO_PUBLIC_UPTICK_INTEGRATION_ID=6566682a-1bec-57de-b0de-4142debba234
EXPO_PUBLIC_UPTICK_INLINE_PLACEMENT=order_confirmation
EXPO_PUBLIC_UPTICK_POPUP_PLACEMENT=order_confirmation
# Optional, when the two placements live on different integrations:
EXPO_PUBLIC_UPTICK_INLINE_INTEGRATION_ID=29927783-d2f2-5fc9-9e43-e1cd5e991a13
