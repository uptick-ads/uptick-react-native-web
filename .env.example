# Copy to .env.local (gitignored). Each mode needs a placement whose template matches it (inline template for Inline, popup template for Modal).
EXPO_PUBLIC_UPTICK_HOST=api.uptick.com
EXPO_PUBLIC_UPTICK_INTEGRATION_ID=AAAAAAAA-BBBB-CCCC-DDDD-EEEEEEEEEEEE
EXPO_PUBLIC_UPTICK_INLINE_PLACEMENT=checkout
EXPO_PUBLIC_UPTICK_MODAL_PLACEMENT=order_confirmation
# Optional, when the two placements live on different integrations:
# EXPO_PUBLIC_UPTICK_INLINE_INTEGRATION_ID=
# EXPO_PUBLIC_UPTICK_MODAL_INTEGRATION_ID=
